# Copy this file to .env.local and adjust as needed.
# Every value here maps 1:1 to src/sdk/config.js - nothing else in the app
# reads env vars directly.

# --- account-service, via the dev proxy -------------------------------
# account-service requires a shared secret that also gates registration,
# balance lookups and API-key minting. It must NOT reach the browser, so
# these two are deliberately NOT VITE_-prefixed: only vite.config.js reads
# them, and it attaches the header to proxied requests server-side. Adding a
# VITE_ prefix to ROVIE_API_KEY would publish the key to every visitor.
# Value is ROVIE_API_KEY from the Rovie Route .env.
ROVIE_API_KEY=
ROVIE_ACCOUNT_SERVICE_ORIGIN=http://localhost:4001

# Leave VITE_ACCOUNT_SERVICE_URL unset in dev - the app then talks to the
# same-origin /api/account proxy above, which needs no CORS. Set it only to
# point at an already-public API that does its own auth.
# VITE_ACCOUNT_SERVICE_URL=

# Local development defaults (see usage.md). Leave unset to use these.
VITE_PAYMENT_SERVICE_URL=http://localhost:4003
VITE_LITELLM_URL=http://localhost:4000

# Production overrides everything above to https://api.getrovie.com
# automatically when building with `vite build` (import.meta.env.PROD).
# Set these instead if you need to point a prod build somewhere else:
# VITE_ACCOUNT_SERVICE_URL=https://api.getrovie.com
# VITE_PAYMENT_SERVICE_URL=https://api.getrovie.com
# VITE_LITELLM_URL=https://api.getrovie.com

# Fills /rankings with FABRICATED sample data so the layout can be reviewed
# before real traffic exists. `?demo=1` on the URL does the same thing without
# a restart, and `?demo=0` forces the real endpoint back on.
#
# The page prints a banner saying the figures are invented whenever this is
# active. Never set it on a build the public can reach - and note it replaces
# the request entirely rather than acting as a fallback, so a broken API still
# shows an error rather than quietly serving made-up usage stats.
# VITE_MOCK_RANKINGS=true

# Client-side IP geolocation used to detect the visitor's country for the
# homepage map + cost badge. geojs.io is free and CORS-friendly; swap in
# your own provider if you prefer.
VITE_IP_GEO_URL=https://get.geojs.io/v1/ip/geo.json

# --- portal-api: sign-in, sessions, dashboard ---------------------------
# The service that holds the session cookie (apps/portal-api in the Rovie
# Route repo, port 4002). Unlike account-service above this is NOT proxied
# through the Vite dev server - the Google and magic-link callbacks land on
# portal-api's own origin, so routing normal calls through a proxy would put
# the session cookie in one place and look for it in another.
#
# Leave unset in dev to use http://localhost:4002. A production build points
# at https://api.getrovie.com automatically.
#
# NOTE: portal-api only accepts credentialed requests from origins listed in
# its own PORTAL_WEB_ORIGIN (default http://localhost:5173). If Vite starts
# on another port because 5173 was taken, sign-in fails with "This page isn't
# allowed to sign in" until you add that origin there.
# VITE_PORTAL_API_URL=

# --- docs.rovie.africa --------------------------------------------------
# The documentation is a SEPARATE SITE (docs/ in this repo, Astro + Starlight),
# not a route in this app - so every link to it is an absolute URL and a real
# cross-origin navigation. Read by src/content/navLinks.ts.
#
# Unset, this follows the environment like the services above: the Astro dev
# server in dev, https://docs.rovie.africa in a production build. Start it with
# `cd docs && npm run dev`.
#
# There is no way to reach it through this dev server. A subdomain does not
# create a server - docs.localhost:5173 resolves to 127.0.0.1 and then hits
# Vite on 5173, which is this app and serves index.html for every path. It is
# a different process on a different port, always.
#
# Set this to the deployed docs if you would rather not run them locally:
# VITE_DOCS_URL=https://docs.rovie.africa
